#!/usr/sbin/nft -f
# Managed by Ansible.
# Only our table is replaced: no `flush ruleset`, Docker's iptables-nft tables stay intact.
# Docker-published 443 is DNATed and goes through FORWARD (Docker's rules), not this input chain.

table inet botato
delete table inet botato

table inet botato {
	# Filled by fwknopd after a valid SPA packet.
	set ssh_allowed {
		type ipv4_addr
		flags timeout
	}

	chain input {
		type filter hook input priority filter; policy drop;

		ct state established,related accept
		ct state invalid drop
		iif lo accept

		# ICMP the network needs (PMTU discovery, errors, IPv6 neighbor discovery).
		ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		ip6 nexthdr icmpv6 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept

		# STUN/TURN and TURN over TLS.
		udp dport 3478 accept
		tcp dport { 3478, 5349 } accept
		# coturn relay ports.
		udp dport {{ turn_min_port }}-{{ turn_max_port }} accept

		# fwknopd (Debian builds it without pcap: it is a plain UDP listener that never replies).
		udp dport {{ fwknop_port }} accept

		# SSH only for addresses that knocked.
		tcp dport {{ ssh_port }} ip saddr @ssh_allowed accept
	}
}
