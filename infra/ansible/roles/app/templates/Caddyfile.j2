# Managed by Ansible. No `log` directive: no access log.
{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
	log default {
		output stderr
		level ERROR
	}
}

{{ relay_domain }} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	handle /ws {
		reverse_proxy relay:8080
	}
	handle /manifest {
		reverse_proxy relay:8080
	}
	handle {
		respond 404
	}
}
