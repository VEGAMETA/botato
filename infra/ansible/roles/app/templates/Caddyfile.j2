# Managed by Ansible. No `log` directive: no access log.
{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
	log default {
		output stderr
		level ERROR
	}
}

{{ relay_domain }} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	handle /ws {
		reverse_proxy relay:8080
	}
	handle /manifest {
		reverse_proxy relay:8080
	}
	# App updates; clients verify the admin signature in release.bin before installing.
	handle /releases/* {
		root * /srv
		header /releases/release.bin Cache-Control no-cache
		header /releases/botato-latest* Cache-Control no-cache
		file_server
	}
{% if caddy_behind_xray %}
	# Family VPN subscriptions (vpn repo, roles/vpn-sub): one static file per person, name = secret token.
	# No browse: /s/ and unknown tokens are 404.
	handle_path /s/* {
		root * /srv/vpn-sub
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control no-store
		header Profile-Update-Interval 6
		header Profile-Title "base64:0KHQtdC80YzRjyBWUE4="
		file_server
	}
{% endif %}
	handle {
		respond 404
	}
}
